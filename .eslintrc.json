{
  "root": true,
  "extends": ["eslint:recommended"],
  "ignorePatterns": [
    "node_modules/",
    ".playwright-browsers/",
    ".sisyphus/evidence/"
  ],
  "overrides": [
    {
      "files": ["scripts/app.js"],
      "env": {
        "browser": true,
        "es2022": true
      },
      "globals": {
        "XLSX": "readonly",
        "html2canvas": "readonly",
        "jspdf": "readonly",
        "KEII18n": "readonly"
      }
    },
    {
      "files": ["scripts/gateway.js"],
      "env": {
        "browser": true,
        "es2022": true
      },
      "globals": {
        "KEII18n": "readonly"
      }
    },
    {
      "files": ["scripts/i18n/dict.js"],
      "env": {
        "browser": true,
        "node": true,
        "es2022": true
      }
    },
    {
      "files": ["scripts/data/contract.js"],
      "env": {
        "browser": true,
        "node": true,
        "es2022": true
      }
    },
    {
      "files": ["playwright.config.js", "tests/**/*.js", "scripts/**/*.mjs"],
      "env": {
        "node": true,
        "es2022": true
      },
      "parserOptions": {
        "sourceType": "module"
      }
    },
    {
      "files": ["scripts/**/*.mjs"],
      "rules": {
        "no-undef": "off"
      }
    },
    {
      "files": ["tests/**/*.js"],
      "rules": {
        "no-undef": "off"
      }
    }
  ]
}
