{
  "name": "kei-project-search",
  "version": "0.1.0",
  "private": true,
  "description": "Static KEI project explorer runtime baseline",
  "scripts": {
    "prepare": "husky",
    "dev": "node scripts/serve.mjs 4173",
    "health:app": "node scripts/health-app.mjs",
    "ci:local": "node scripts/ci-local.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "check:bundle-structure": "node scripts/check-bundle-structure.mjs",
    "check:a11y": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers node scripts/check-a11y.mjs",
    "lint": "eslint \"playwright.config.js\" \"scripts/**/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.js\"",
    "format": "prettier --write \".github/workflows/**/*.yml\" \"package.json\" \"playwright.config.js\" \"scripts/**/*.mjs\" \"tests/**/*.js\"",
    "format:check": "prettier --check \".github/workflows/**/*.yml\" \"package.json\" \"playwright.config.js\" \"scripts/**/*.mjs\" \"tests/**/*.js\"",
    "test:smoke": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test tests/e2e/baseline.spec.js --grep @smoke",
    "test:e2e:playwright": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test tests/e2e/gateway.spec.js tests/e2e/baseline.spec.js tests/e2e/i18n.spec.js tests/e2e/facets.spec.js tests/e2e/project-detail.spec.js tests/e2e/contract.spec.js tests/e2e/thumbnails.spec.js",
    "test:e2e:failure-evidence": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test tests/e2e/failure-evidence.spec.js",
    "test:e2e": "npm run test:e2e:playwright && npm run verify:export && npm run verify:keyboard && npm run verify:search-date",
    "validate:data": "node scripts/validate-data.mjs && node scripts/validate-gateway-data.mjs",
    "validate:gateway": "node scripts/validate-gateway-data.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:security": "node scripts/check-security.mjs",
    "perf:export": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers node scripts/perf-export.mjs",
    "verify:export": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers node scripts/verify-export-flow.mjs",
    "verify:keyboard": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers node scripts/verify-keyboard-accessibility.mjs",
    "verify:search-date": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers node scripts/verify-search-date-filter.mjs",
    "verify:manual-qa": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers node scripts/verify-manual-qa.mjs"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "playwright": "^1.52.0",
    "prettier": "^3.5.3"
  },
  "lint-staged": {
    "*.{js,mjs,json,yml,yaml,md,css,html}": [
      "prettier --check"
    ],
    "scripts/**/*.{js,mjs}": [
      "eslint"
    ],
    "tests/**/*.js": [
      "eslint"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
